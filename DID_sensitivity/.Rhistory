raw <- bind_rows(lapply(1:R, function(r) analyse(gfun(nsim), Lgrid)), .id = "rep")
raw |>
mutate(tr = truth[target]) |>
group_by(target, Lambda) |>
summarise(truth = first(tr), mean_lo = mean(lower), mean_hi = mean(upper),
width = mean(upper - lower),
coverage = mean(lower <= tr & tr <= upper),
excl_0 = mean(lower > 0 | upper < 0), .groups = "drop")
}
# =============================================================================
# 6. Study 2: calibration quantities, both designs
# =============================================================================
set.seed(2264); cal  <- t(replicate(60, calib(gen(nsim))))
set.seed(2264); cal2 <- t(replicate(40, calib(gen2(nsim))))
cat("\nCalibration quantities:\n")
print(rbind(
DGP1 = c(mean = mean(cal[, 1]),  sd = sd(cal[, 1]),
mean_D = mean(cal[, 2]),  sd_D = sd(cal[, 2])),
DGP2 = c(mean = mean(cal2[, 1]), sd = sd(cal2[, 1]),
mean_D = mean(cal2[, 2]), sd_D = sd(cal2[, 2]))) |> round(3))
# Coverage in Study 1 required Lambda ~ 2 in both designs. Comparing that with
# the pre-adoption departure actually visible gives the multiple M a reader
# would have to accept; it exceeds 1 in both, so calibrating at M = 1 undercovers.
cat("\nimplied M = 2 / Lambda_pre:  DGP1", round(2 / mean(cal[, 1]), 2),
" DGP2", round(2 / mean(cal2[, 1]), 2), "\n")
# Computed from the seeded pilots so the figure labels and paper are reproducible
cat("\nmean pairwise trend correlation:  DGP1",
round(trend_cor(pilot), 3), " DGP2", round(trend_cor(pil2), 3), "\n")
# =============================================================================
# 7. Study 3: effect of the coherence constraints, both designs  (Table 2, Figure 2)
# =============================================================================
# Run at Lambda = 3, the smallest grid value at which the uncoupled bounds for
# s >= 2 and the overall effect (almost) never exclude zero, so any recovered
# power is attributable to coherence alone. Slow: ~50 min for both designs.
if (RUN_COHERENCE) {
coh_one <- function(gfun, reps) bind_rows(lapply(1:reps, function(r) {
d <- gfun(nsim)
bind_rows(lapply(c(Inf, 1.25, 1), function(LD) analyse_coh(d, 3, LD)))
}), .id = "rep")
set.seed(6157); cohdf <- coh_one(gen,  25)
set.seed(6157); coh2  <- coh_one(gen2, 20)
# Per-replicate quantities must be computed before the bounds are averaged:
# summarise() evaluates sequentially, so naming the means `lower`/`upper`
# would overwrite the replicate vectors used by coverage and excl_0.
coh_sum <- function(raw, truth) raw |>
mutate(tr = truth[target]) |>
group_by(target, LamD) |>
summarise(width    = mean(upper - lower),
coverage = mean(lower <= tr & tr <= upper),
excl_0   = mean(lower > 0 | upper < 0),
lower = mean(lower), upper = mean(upper), .groups = "drop")
cohsum <- coh_sum(cohdf, tau_true)
coh2s  <- coh_sum(coh2,  tau_true2)
cat("\nWidth reduction from coherence and exclusion of zero (Table 2):\n")
bind_rows(cohsum |> mutate(dgp = "DGP1"), coh2s |> mutate(dgp = "DGP2")) |>
group_by(dgp, target) |>
mutate(red = 100 * (1 - width / width[is.infinite(LamD)])) |>
ungroup() |> filter(is.finite(LamD)) |>
transmute(dgp, target, LamD, red = round(red, 1), excl_0) |>
pivot_wider(names_from = LamD, values_from = c(red, excl_0)) |>
print(width = Inf)
}
# =============================================================================
# 8. Figures
# =============================================================================
lev    <- c(paste0("dyn", 1:Tn), "overall")
labs   <- c("s = 1", "s = 2", "s = 3", "s = 4", "overall")
dgplab <- c("DGP 1: trend correlation 0.45", "DGP 2: trend correlation 0.07")
ylim_fig <- c(-5, 15)  # common y-axis for Figures 1 and 2
sweep <- bind_rows(summ  |> mutate(dgp = dgplab[1]),
summ2 |> mutate(dgp = dgplab[2])) |>
mutate(target = factor(target, lev, labs))
# =============================================================================
# Simulation study for "A Linear Programming Sensitivity Analysis for Parallel
# Trends in Staggered Difference-in-Differences" (sensitivity.tex, Section 4).
#
# Reproduces Table 1 (coverage and width), the calibration figures, and
# Table 2 (effect of the coherence constraints).
#
# Approximate runtimes on a laptop: coverage 8 min, calibration 0.5 min,
# coherence 50 min. Set RUN_COHERENCE to FALSE to skip the slow arm.
# =============================================================================
suppressPackageStartupMessages({
library(Rglpk)      # sparse LP solver (GLPK)
library(slam)       # simple_triplet_matrix, for the sparse constraint matrix
library(nnet)       # multinomial logistic regression for the nominal odds
library(tidyverse)
})
RUN_COHERENCE <- TRUE
# Slack on each moment constraint, in standard errors per moment (paper, eq. for
# the slackened program). c_n is a tuning constant, not a sensitivity parameter;
# the paper's default is 2. Set to 0 for exact equalities.
CN <- 2
Tn    <- 4                      # periods are 0 (baseline), 1, ..., Tn
theta <- c(1.0, 1.5, 2.0, 2.5)  # true dynamic effects at durations s = 1..Tn
# The decision variables are a_{i,g,k}, indexed by cohort g and borrowing period
# k with g <= k. Each (g,k) pair is one "block" of the linear program.
gk <- expand.grid(k = 1:Tn, g = 1:Tn) |> subset(g <= k)
# predict(multinom(...)) returns a vector rather than a matrix when the response
# has only two levels, which happens for the later borrowing periods where few
# cohorts remain untreated. This restores a consistent matrix form.
probs_mat <- function(f, lev) {
pp <- predict(f, type = "probs")
if (is.null(dim(pp))) pp <- cbind(1 - pp, pp)
colnames(pp) <- lev
pp
}
# -----------------------------------------------------------------------------
# 1. Data-generating process
# -----------------------------------------------------------------------------
# A latent U enters BOTH the cohort assignment and every untreated trend. That
# is what makes adoption selected on the untreated trend, so conditional
# parallel trends fails and the plug-in estimator is biased. X is an observed
# baseline covariate that the method is allowed to condition on.
gen <- function(n) {
X <- rnorm(n)
U <- rnorm(n)
# Cohort assignment: coefficient on U decreases in g, so units with high U
# (and hence steep untreated trends) adopt earlier. Last column is the
# never-treated group, needed because period Tn has no other comparison set.
eta <- cbind(0.2 + 0.4 * X + 0.8 * U,
0.3 + 0.3 * X + 0.5 * U,
0.3 + 0.2 * X + 0.3 * U,
0.2 + 0.1 * X + 0.1 * U,
0)
# Gumbel-max trick: argmax of (eta + Gumbel noise) is a multinomial draw.
Gi <- max.col(eta - log(-log(matrix(runif(n * 5), n, 5))))
G  <- ifelse(Gi == 5, Inf, Gi)
# Untreated potential trends; U enters every period, so departures from
# parallel trends are large and roughly constant over time.
dY <- sapply(1:Tn, function(k) 0.1 * k + 0.5 * X + 0.8 * U + rnorm(n))
# Untreated potential outcome path, then add the effect once treated.
# Column t+1 of Y holds period t, so Y[, 1] is the baseline.
Y <- cbind(X + U + rnorm(n), matrix(0, n, Tn))
Y[, -1] <- Y[, 1] + t(apply(dY, 1, cumsum))
for (t in 1:Tn) {
i <- which(G <= t)
Y[i, t + 1] <- Y[i, t + 1] + theta[t - G[i] + 1]
}
# dY returned here is the OBSERVED first difference; for units with G > k it
# equals the untreated trend, which is what the estimator borrows.
list(G = G, X = X, Y = Y, dY = Y[, -1] - Y[, -(Tn + 1)])
}
# Effects are homogeneous across cohorts, so tau^dyn_s = theta_s exactly. The
# overall ATT depends on the cohort shares, which we pin down with a large pilot.
set.seed(5512)
pilot    <- gen(2e5)
pG       <- sapply(1:Tn, function(g) mean(pilot$G == g))
p_s      <- sapply(1:Tn, function(s) sum(pG[1:(Tn - s + 1)]))   # aggregation weights
tau_true <- c(theta, sum(p_s * theta) / sum(p_s))
names(tau_true) <- c(paste0("dyn", 1:Tn), "overall")
# --- DGP 2: weakly correlated untreated trends -------------------------------
# Coherence should bind hardest when a unit's trends vary independently across
# periods, since only then does forcing one common departure restrict anything.
# DGP 2 therefore replaces the single latent with period-specific shocks U_k and
# lets adoption depend on their average, which keeps selection on trends alive.
# cU scales selection strength; cU = 3 matches DGP 1 on Lambda_pre, so the two
# designs differ only in how correlated the trends are.
cU_star <- 3
gen2 <- function(n, cU = cU_star) {
X  <- rnorm(n)
Uk <- matrix(rnorm(n * Tn), n, Tn)        # independent across periods
Ub <- rowMeans(Uk)
eta <- cbind(0.2 + 0.4*X + cU*0.8*Ub, 0.3 + 0.3*X + cU*0.5*Ub,
0.3 + 0.2*X + cU*0.3*Ub, 0.2 + 0.1*X + cU*0.1*Ub, 0)
Gi <- max.col(eta - log(-log(matrix(runif(n * 5), n, 5))))
G  <- ifelse(Gi == 5, Inf, Gi)
dY <- sapply(1:Tn, function(k) 0.1*k + 0.5*X + 1.2*Uk[, k] + rnorm(n))
Y  <- cbind(X + Ub + rnorm(n), matrix(0, n, Tn))
Y[, -1] <- Y[, 1] + t(apply(dY, 1, cumsum))
for (t in 1:Tn) { i <- which(G <= t); Y[i, t+1] <- Y[i, t+1] + theta[t - G[i] + 1] }
list(G = G, X = X, Y = Y, dY = Y[, -1] - Y[, -(Tn+1)])
}
# Mean pairwise correlation of untreated trends, computed among the
# never-treated since only they have every period untreated.
trend_cor <- function(d) {
nt <- which(is.infinite(d$G))
mean(cor(d$dY[nt, ])[upper.tri(diag(Tn))])
}
set.seed(7742)
pil2      <- gen2(2e5)
pG2       <- sapply(1:Tn, function(g) mean(pil2$G == g))
ps2       <- sapply(1:Tn, function(s) sum(pG2[1:(Tn - s + 1)]))
tau_true2 <- c(theta, sum(ps2 * theta) / sum(ps2))
names(tau_true2) <- names(tau_true)
# -----------------------------------------------------------------------------
# 2. Bounds without coherence constraints (block-separable, fast)
# -----------------------------------------------------------------------------
# With Lambda_Delta = Lambda^2 the coherence constraints are vacuous and the
# program separates: each (g,k) block has its own moment constraints and box,
# and every target's objective restricted to a block is a NONNEGATIVE multiple
# of the same functional sum_i a_{i,g,k} * dY_ik. So one optimisation per block
# per direction serves all five targets at once.
# Cohorts whose horizon-s cell needs the period-k trend: g <= k <= g+s-1.
Wset <- function(s, k) {
lo <- max(1, k - s + 1); hi <- min(k, Tn - s + 1)
if (lo > hi) integer(0) else lo:hi
}
analyse <- function(d, Lams,
H = list(function(x) rep(1, length(x)), function(x) x)) {
n <- length(d$G); fG <- factor(d$G); lev <- levels(fG)
# Nominal odds ahat_{g,k}(X) = P(G=g|X) / P(G>k|X), the centre of the box.
pih <- probs_mat(multinom(fG ~ d$X, trace = FALSE), lev)
gcn <- as.numeric(lev)                       # "Inf" parses to Inf, so Inf > k is TRUE
Pgt <- sapply(0:Tn, function(k) rowSums(pih[, gcn > k, drop = FALSE]))
blocks <- lapply(seq_len(nrow(gk)), function(j) {
g <- gk$g[j]; k <- gk$k[j]
idx <- which(d$G > k)                      # units still untreated at k
Hm  <- sapply(H, function(f) f(d$X[idx]))  # constraint functions
Hg  <- sapply(H, function(f) f(d$X[d$G == g]))
ah  <- pih[idx, as.character(g)] / Pgt[idx, k + 1]
# Standard error of each moment evaluated at the box centre: the two
# indicator sets {G > k} and {G = g} are disjoint for g <= k, so the
# squared summand splits into the two sums below. The constraints are
# written as sums, so the slack on the sum is CN * s * sqrt(n).
s2 <- (colSums(Hm^2 * ah^2) + colSums(Hg^2)) / n
list(g = g, k = k,
dY    = d$dY[idx, k],                 # objective weights
Hm    = Hm,
tgt   = colSums(Hg),                  # constraint targets
slack = CN * sqrt(s2) * sqrt(n),
ah    = ah)
})
# Per block: optimise sum_i a_i dY_i subject to |sum_i h_j(X_i) a_i - tgt_j|
# <= slack_j and the box. Two rows per h, one for each side of the slack.
solve_blk <- function(b, Lam) {
nb <- length(b$dY); J <- ncol(b$Hm)
A <- simple_triplet_matrix(
i = rep(c(1:J, (J + 1):(2 * J)), each = nb),
j = rep(rep(1:nb, J), 2),
v = rep(as.vector(b$Hm), 2), nrow = 2 * J, ncol = nb)
bnd <- list(lower = list(ind = 1:nb, val = b$ah / Lam),
upper = list(ind = 1:nb, val = b$ah * Lam))
sapply(c(FALSE, TRUE), function(mx)
Rglpk_solve_LP(b$dY, A, c(rep("<=", J), rep(">=", J)),
c(b$tgt + b$slack, b$tgt - b$slack), bounds = bnd, max = mx)$optimum)
}
key <- paste(sapply(blocks, `[[`, "g"), sapply(blocks, `[[`, "k"))
# Observed treated-side terms. Cs[s] is the long difference for cohorts that
# reach duration s; Co is its analogue summed over the whole triangle.
Cs <- sapply(1:Tn, function(s) {
i <- which(d$G <= Tn - s + 1)
sum(d$Y[cbind(i, d$G[i] + s)] - d$Y[cbind(i, d$G[i])])
})
Ns <- sapply(1:Tn, function(s) sum(d$G <= Tn - s + 1))
ti <- which(d$G <= Tn)
Co <- sum(sapply(ti, function(i) sum(d$Y[i, (d$G[i] + 1):(Tn + 1)] - d$Y[i, d$G[i]])))
No <- sum(Tn - d$G[ti] + 1)
do.call(rbind, lapply(Lams, function(Lam) {
S <- t(sapply(blocks, solve_blk, Lam = Lam))   # column 1 = min, column 2 = max
rownames(S) <- key
# The block sum enters the estimand with a minus sign, so the LOWER bound on
# the effect uses the block MAXIMA and vice versa.
out <- t(sapply(1:Tn, function(s) {
ky <- unlist(lapply(1:Tn, function(k) {
w <- Wset(s, k); if (length(w)) paste(w, k) else NULL }))
c(lower = (Cs[s] - sum(S[ky, 2])) / Ns[s],
upper = (Cs[s] - sum(S[ky, 1])) / Ns[s])
}))
wt <- Tn - as.integer(sub(".* ", "", key)) + 1   # multiplicity (T-k+1) for the overall ATT
rbind(data.frame(target = paste0("dyn", 1:Tn), Lambda = Lam, out),
data.frame(target = "overall", Lambda = Lam,
lower = (Co - sum(wt * S[, 2])) / No,
upper = (Co - sum(wt * S[, 1])) / No))
}))
}
# -----------------------------------------------------------------------------
# 3. Bounds WITH coherence constraints (single joint program, slower)
# -----------------------------------------------------------------------------
# Coherence links a_{i,g,k} to a_{i,g,k-1}, which destroys block separability,
# so all variables must be carried in one program and each target solved
# separately. LamD = Inf means the constraints are omitted (the neutral case).
analyse_coh <- function(d, Lam, LamD,
H = list(function(x) rep(1, length(x)), function(x) x)) {
n <- length(d$G); fG <- factor(d$G); lev <- levels(fG)
pih <- probs_mat(multinom(fG ~ d$X, trace = FALSE), lev)
gcn <- as.numeric(lev)
Pgt <- sapply(0:Tn, function(k) rowSums(pih[, gcn > k, drop = FALSE]))
# One row per decision variable a_{i,g,k}.
V <- do.call(rbind, lapply(1:nrow(gk), function(j) {
g <- gk$g[j]; k <- gk$k[j]; idx <- which(d$G > k)
data.frame(i = idx, g = g, k = k, dY = d$dY[idx, k],
ah = pih[idx, as.character(g)] / Pgt[idx, k + 1])
}))
p <- nrow(V)
# Moment constraints, two rows per (h, g, k) for the two sides of the slack.
# The slack is CN standard errors of the moment at the box centre, as in
# analyse(); see the comment there.
tr <- list(); rh <- c(); dr <- c(); rr <- 0
for (hh in seq_along(H)) for (j in 1:nrow(gk)) {
g <- gk$g[j]; k <- gk$k[j]
sel <- which(V$g == g & V$k == k)
hv  <- H[[hh]](d$X[V$i[sel]])
hg  <- H[[hh]](d$X[d$G == g])
tg  <- sum(hg)
slack <- CN * sqrt((sum(hv^2 * V$ah[sel]^2) + sum(hg^2)) / n) * sqrt(n)
rr <- rr + 1; tr[[length(tr) + 1]] <- data.frame(row = rr, col = sel, v = hv)
rh <- c(rh, tg + slack); dr <- c(dr, "<=")
rr <- rr + 1; tr[[length(tr) + 1]] <- data.frame(row = rr, col = sel, v = hv)
rh <- c(rh, tg - slack); dr <- c(dr, ">=")
}
# Coherence: r_{i,g,k} <= LamD * r_{i,g,k-1} and conversely, where
# r = a / ahat is the deviation from the box centre. Cross-multiplying by the
# centres keeps both inequalities linear in a.
if (is.finite(LamD)) {
pv <- match(paste(V$i, V$g, V$k - 1), paste(V$i, V$g, V$k))
jj <- which(!is.na(pv)); pj <- pv[jj]; m <- length(jj)
tr[[length(tr) + 1]] <- data.frame(row = rr + rep(1:m, 2), col = c(jj, pj),
v = c(1 / V$ah[jj], -LamD / V$ah[pj]))
tr[[length(tr) + 1]] <- data.frame(row = rr + m + rep(1:m, 2), col = c(pj, jj),
v = c(1 / V$ah[pj], -LamD / V$ah[jj]))
rh <- c(rh, rep(0, 2 * m)); dr <- c(dr, rep("<=", 2 * m)); rr <- rr + 2 * m
}
tt <- do.call(rbind, tr)
A <- simple_triplet_matrix(tt$row, tt$col, tt$v, nrow = rr, ncol = p)
bnd <- list(lower = list(ind = 1:p, val = V$ah / Lam),
upper = list(ind = 1:p, val = V$ah * Lam))
Cs <- sapply(1:Tn, function(s) {
i <- which(d$G <= Tn - s + 1)
sum(d$Y[cbind(i, d$G[i] + s)] - d$Y[cbind(i, d$G[i])])
})
Ns <- sapply(1:Tn, function(s) sum(d$G <= Tn - s + 1))
ti <- which(d$G <= Tn)
Co <- sum(sapply(ti, function(i) sum(d$Y[i, (d$G[i] + 1):(Tn + 1)] - d$Y[i, d$G[i]])))
No <- sum(Tn - d$G[ti] + 1)
go <- function(cf, C, N) sapply(c(FALSE, TRUE), function(mx)
(C + Rglpk_solve_LP(cf, A, dr, rh, bounds = bnd, max = mx)$optimum) / N)
out <- lapply(1:Tn, function(s)
go(-V$dY * mapply(function(g, k) as.numeric(g %in% Wset(s, k)), V$g, V$k),
Cs[s], Ns[s]))
out[[Tn + 1]] <- go(-V$dY * (Tn - V$k + 1), Co, No)
data.frame(target = c(paste0("dyn", 1:Tn), "overall"), LamD = LamD,
lower = sapply(out, `[`, 1), upper = sapply(out, `[`, 2))
}
# -----------------------------------------------------------------------------
# 4. Calibration quantities from pre-adoption periods
# -----------------------------------------------------------------------------
# For k < g the cohort-g unit is still untreated at period k, so the
# trend-dependent odds is POINT IDENTIFIED there. The deviation factor is the
# ratio of two fits within {G > k}: one that conditions on the trend and one
# that does not. Lambda_pre is the size of that deviation; Lambda_Delta,pre is
# how much it changes between adjacent periods, which needs two pre-periods and
# so is only available for cohorts with g >= 3.
calib <- function(d, q = 0.95) {
dev <- function(sub, g, kk) {
fg <- factor(d$G[sub]); lev <- levels(fg)
dd <- d$dY[sub, kk]; xx <- d$X[sub]
probs_mat(multinom(fg ~ xx + dd, trace = FALSE), lev)[, as.character(g)] /
probs_mat(multinom(fg ~ xx,      trace = FALSE), lev)[, as.character(g)]
}
lp <- ld <- c()
for (g in 2:Tn) for (k in 1:(g - 1)) {
sub <- which(d$G > k)
r   <- dev(sub, g, k)
# Symmetrised so that departures in either direction count, then trimmed:
# a supremum here would not be root-n estimable and is tail-driven.
lp <- c(lp, quantile(pmax(r, 1 / r), q, names = FALSE))
if (k >= 2) {
rho <- r / dev(sub, g, k - 1)
ld  <- c(ld, quantile(pmax(rho, 1 / rho), q, names = FALSE))
}
}
c(lam_pre = max(lp), lamD_pre = max(ld))
}
# =============================================================================
# 5. Study 1: bias, coverage and width, both designs  (Table 1, Figure 1)
# =============================================================================
R <- 150; nsim <- 2000; Lgrid <- c(1, 1.5, 2, 3, 5)
sweep_one <- function(gfun, truth) {
raw <- bind_rows(lapply(1:R, function(r) analyse(gfun(nsim), Lgrid)), .id = "rep")
raw |>
mutate(tr = truth[target]) |>
group_by(target, Lambda) |>
summarise(truth = first(tr), mean_lo = mean(lower), mean_hi = mean(upper),
width = mean(upper - lower),
coverage = mean(lower <= tr & tr <= upper),
excl_0 = mean(lower > 0 | upper < 0), .groups = "drop")
}
set.seed(9014); summ  <- sweep_one(gen,  tau_true)
set.seed(9014); summ2 <- sweep_one(gen2, tau_true2)
# At Lambda = 1 the box pins a to ahat, so the bounds collapse to the plug-in
# estimator; its distance from the truth is the bias induced by the violation.
# The two designs are matched, so these should agree closely.
cat("\nPlug-in bias (Lambda = 1):\n")
bind_rows(summ |> mutate(dgp = "DGP1"), summ2 |> mutate(dgp = "DGP2")) |>
filter(Lambda == 1) |>
transmute(dgp, target, bias = round(mean_lo - truth, 2)) |>
pivot_wider(names_from = dgp, values_from = bias) |> print()
cat("\nCoverage and width, both designs (Table 1):\n")
bind_rows(summ |> mutate(dgp = "DGP1"), summ2 |> mutate(dgp = "DGP2")) |>
filter(Lambda > 1) |>
transmute(dgp, Lambda, target, cov = round(coverage, 2), w = round(width, 2)) |>
pivot_wider(names_from = target, values_from = c(cov, w)) |>
arrange(dgp, Lambda) |> print(width = Inf)
# =============================================================================
# 6. Study 2: calibration quantities, both designs
# =============================================================================
set.seed(2264); cal  <- t(replicate(60, calib(gen(nsim))))
set.seed(2264); cal2 <- t(replicate(40, calib(gen2(nsim))))
cat("\nCalibration quantities:\n")
print(rbind(
DGP1 = c(mean = mean(cal[, 1]),  sd = sd(cal[, 1]),
mean_D = mean(cal[, 2]),  sd_D = sd(cal[, 2])),
DGP2 = c(mean = mean(cal2[, 1]), sd = sd(cal2[, 1]),
mean_D = mean(cal2[, 2]), sd_D = sd(cal2[, 2]))) |> round(3))
# Coverage in Study 1 required Lambda ~ 2 in both designs. Comparing that with
# the pre-adoption departure actually visible gives the multiple M a reader
# would have to accept; it exceeds 1 in both, so calibrating at M = 1 undercovers.
cat("\nimplied M = 2 / Lambda_pre:  DGP1", round(2 / mean(cal[, 1]), 2),
" DGP2", round(2 / mean(cal2[, 1]), 2), "\n")
# Computed from the seeded pilots so the figure labels and paper are reproducible
cat("\nmean pairwise trend correlation:  DGP1",
round(trend_cor(pilot), 3), " DGP2", round(trend_cor(pil2), 3), "\n")
# =============================================================================
# 7. Study 3: effect of the coherence constraints, both designs  (Table 2, Figure 2)
# =============================================================================
# Run at Lambda = 3, the smallest grid value at which the uncoupled bounds for
# s >= 2 and the overall effect (almost) never exclude zero, so any recovered
# power is attributable to coherence alone. Slow: ~50 min for both designs.
if (RUN_COHERENCE) {
coh_one <- function(gfun, reps) bind_rows(lapply(1:reps, function(r) {
d <- gfun(nsim)
bind_rows(lapply(c(Inf, 1.25, 1), function(LD) analyse_coh(d, 3, LD)))
}), .id = "rep")
set.seed(6157); cohdf <- coh_one(gen,  25)
set.seed(6157); coh2  <- coh_one(gen2, 20)
# Per-replicate quantities must be computed before the bounds are averaged:
# summarise() evaluates sequentially, so naming the means `lower`/`upper`
# would overwrite the replicate vectors used by coverage and excl_0.
coh_sum <- function(raw, truth) raw |>
mutate(tr = truth[target]) |>
group_by(target, LamD) |>
summarise(width    = mean(upper - lower),
coverage = mean(lower <= tr & tr <= upper),
excl_0   = mean(lower > 0 | upper < 0),
lower = mean(lower), upper = mean(upper), .groups = "drop")
cohsum <- coh_sum(cohdf, tau_true)
coh2s  <- coh_sum(coh2,  tau_true2)
cat("\nWidth reduction from coherence and exclusion of zero (Table 2):\n")
bind_rows(cohsum |> mutate(dgp = "DGP1"), coh2s |> mutate(dgp = "DGP2")) |>
group_by(dgp, target) |>
mutate(red = 100 * (1 - width / width[is.infinite(LamD)])) |>
ungroup() |> filter(is.finite(LamD)) |>
transmute(dgp, target, LamD, red = round(red, 1), excl_0) |>
pivot_wider(names_from = LamD, values_from = c(red, excl_0)) |>
print(width = Inf)
}
# =============================================================================
# 8. Figures
# =============================================================================
lev    <- c(paste0("dyn", 1:Tn), "overall")
labs   <- c("s = 1", "s = 2", "s = 3", "s = 4", "overall")
dgplab <- c("DGP 1: trend correlation 0.45", "DGP 2: trend correlation 0.07")
ylim_fig <- c(-5, 15)  # common y-axis for Figures 1 and 2
sweep <- bind_rows(summ  |> mutate(dgp = dgplab[1]),
summ2 |> mutate(dgp = dgplab[2])) |>
mutate(target = factor(target, lev, labs))
# Reference markers shared by both figures: the truth, and the plug-in. The
# latter is the Lambda = 1 interval, which is degenerate -- geom_linerange would
# draw a zero-length bar, an invisible line with a visible legend key -- so it
# is drawn as a point instead.
refs <- sweep |> filter(Lambda == 1) |>
{ \(d) bind_rows(transmute(d, dgp, target, y = truth,   kind = "truth"),
transmute(d, dgp, target, y = mean_lo, kind = "plug-in")) }()
# cairo_pdf embeds fonts; the default pdf device does not, and the Lambda glyph
# comes from the Symbol font, which journals will reject if left unembedded.
ggplot(sweep |> filter(Lambda > 1) |> mutate(Lambda = factor(Lambda)), aes(x = target)) +
geom_hline(yintercept = 0, linetype = 3, colour = "grey50") +
geom_linerange(aes(ymin = mean_lo, ymax = mean_hi, colour = Lambda),
position = position_dodge(width = 0.7), linewidth = 1.2) +
geom_point(data = refs, aes(y = y, shape = kind), size = 2.4) +
facet_wrap(~ dgp) +
scale_shape_manual(values = c(truth = 16, `plug-in` = 4)) +
scale_colour_viridis_d(end = 0.85, direction = -1) +
# Shared y-range so the two figures are directly comparable
coord_cartesian(ylim = ylim_fig) +
labs(x = NULL, y = "ATT", colour = expression(Lambda), shape = NULL) +
theme_minimal(base_size = 11)
ggsave("fig_lambda.pdf", width = 7.6, height = 3.4, device = cairo_pdf)
if (RUN_COHERENCE) {
cohplot <- bind_rows(
cohdf |> mutate(dgp = dgplab[1], tr = tau_true[target]),
coh2  |> mutate(dgp = dgplab[2], tr = tau_true2[target])) |>
group_by(dgp, target, LamD) |>
summarise(lower = mean(lower), upper = mean(upper), truth = first(tr),
.groups = "drop") |>
mutate(target = factor(target, lev, labs),
LamD = factor(LamD, levels = c(Inf, 1.25, 1),
labels = c("none", "1.25", "1")))
# The plug-in does not depend on Lambda_Delta: at Lambda = 1 every deviation
# ratio equals one, so the coherence constraints are slack.
refs2 <- bind_rows(
cohplot |> distinct(dgp, target, truth) |>
transmute(dgp, target, y = truth, kind = "truth"),
refs |> filter(kind == "plug-in"))
ggplot(cohplot, aes(x = target)) +
geom_hline(yintercept = 0, linetype = 3, colour = "grey50") +
geom_linerange(aes(ymin = lower, ymax = upper, colour = LamD),
position = position_dodge(width = 0.65), linewidth = 1.2) +
geom_point(data = refs2, aes(y = y, shape = kind), size = 2.4) +
facet_wrap(~ dgp) +
scale_shape_manual(values = c(truth = 16, `plug-in` = 4)) +
scale_colour_viridis_d(end = 0.85, direction = -1) +
coord_cartesian(ylim = ylim_fig) +
labs(x = NULL, y = "ATT", colour = expression(Lambda[Delta]), shape = NULL) +
theme_minimal(base_size = 11)
ggsave("fig_coherence.pdf", width = 7.6, height = 3.4, device = cairo_pdf)
}
